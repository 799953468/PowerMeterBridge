{
  "mqtt": {
    "host": "192.168.1.10",
    "port": 1883,
    "clientId": "power-meter-bridge",
    "username": "mqtt-user",
    "password": "mqtt-password",
    "keepAliveSeconds": 60
  },
  "homeAssistant": {
    "discoveryPrefix": "homeassistant",
    "currency": "CNY"
  },
  "storage": {
    "stateDirectory": "data/states"
  },
  "pollIntervalSeconds": 60,
  "failureRetrySeconds": 30,
  "devices": [
    {
      "id": "meter-001",
      "name": "客厅电表",
      "brand": "cnyiot",
      "type": "prepaid_meter",
      "enabled": true,
      "config": {
        "sourceUrl": "http://www.wap.cnyiot.com/nat/pay.aspx?mid=19000751693"
      },
      "ha": {
        "deviceId": "cnyiot_meter_001",
        "friendlyName": "客厅电表",
        "baseTopic": "home/meters/001",
        "manufacturer": "CNYIoT",
        "model": "Prepaid Electric Meter"
      },
      "http": {
        "timeoutSeconds": 20,
        "userAgent": "Mozilla/5.0 (compatible; PowerMeterBridge/2.0; +https://github.com/dotnet)"
      }
    }
  ]
}
